---
// Coluna direita: igual em todas as páginas e persistente na navegação
// (não se redesenha ao mudar de bloco). O activo marca-se no cliente.
// Ícones e "O" do logótipo vêm do Figma (public/icones/), sem retoques.
import { blocos, bio, clientes, contactos, links } from '../lib/conteudo';
---
<aside class="direita" transition:persist="painel">
  <div class="topo-dir">
    <header class="cabeca">
      <a href="/" class="logo" aria-label="NUNO — home"><span>NUN</span><span class="o" aria-hidden="true"></span></a>
      <nav class="vistas" aria-label="Views">
        <a href="/" class="vista vista-humana" data-vista="humana" title="Human view" aria-label="Human view"></a>
        <a href="/machine/" class="vista vista-maquina" data-vista="maquina" title="Machine view" aria-label="Machine view: content for language models and agents"></a>
      </nav>
    </header>

    <nav class="blocos" aria-label="Areas of practice">
      <ul>
        {blocos.map((b) => <li><a href={b.href} data-bloco={b.slug}>{b.especialidade}</a></li>)}
      </ul>
    </nav>

    <section class="bio texto" aria-label="About">
      <p><b class="cor3">{bio.nome}</b> {bio.linha.replace(/\s*\|\s*/g, ' · ')}</p>
      <p>{bio.texto}</p>
    </section>

    <section class="clientes texto" aria-label="Clients">
      <p><b class="cor3">Clients</b> {clientes.map((c, i) => <>{i > 0 && ' · '}<b>{c.nome}</b> {c.descricao}</>)}</p>
    </section>
  </div>

  <footer class="rodape contactos texto">
    <div class="pe">
      <ul class="icones">{links.redes.map((l) => (
        <li>{l.url
          ? <a href={l.url} rel="me noopener" target="_blank" aria-label={l.nome} title={l.nome}><img src={`/icones/${l.icone}.svg`} alt="" /></a>
          : <span class="por-ligar" title={`${l.nome} — link in preparation`}><img src={`/icones/${l.icone}.svg`} alt={l.nome} /></span>}</li>))}
      </ul>
      <div class="textos">
        <p><a href={`mailto:${contactos.email}`}>{contactos.email}</a><span class="sep-tel"> · </span><a class="tel" href={`tel:${contactos.telefone.replace(/\s/g, '')}`}>{contactos.telefone}</a></p>
        <p>{[...links.cv, links.redes[links.redes.length - 1]].map((l, i) => <>{i > 0 && ' · '}{l.url ? <a href={l.url} rel="me noopener" target={l.url.endsWith('.pdf') ? undefined : '_blank'}>{l.nome}</a> : <span class="por-ligar" title="Link in preparation">{l.nome}</span>}</>)}</p>
      </div>
    </div>
  </footer>
</aside>

<script>
  // Marca o bloco activo e a vista (humana/máquina) a cada mudança de página.
  // Blocos visitados ficam guardados neste browser (o :visited do CSS não
  // deixa mudar o estilo do sublinhado, só a cor).
  const CHAVE = 'nuno-visitados';
  const lidos = (): string[] => { try { return JSON.parse(localStorage.getItem(CHAVE) || '[]'); } catch { return []; } };
  const marcar = () => {
    const p = location.pathname;
    const vistos = new Set(lidos());
    if (document.querySelector(`.blocos a[href="${p}"]`) && !vistos.has(p)) {
      vistos.add(p);
      try { localStorage.setItem(CHAVE, JSON.stringify([...vistos])); } catch {}
    }
    document.querySelectorAll<HTMLAnchorElement>('.blocos a').forEach((a) => {
      const on = p === a.getAttribute('href');
      a.classList.toggle('visitado', vistos.has(a.getAttribute('href')!));
      a.classList.toggle('activo', on);
      if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    });
    const maquina = p.startsWith('/machine');
    document.querySelectorAll<HTMLAnchorElement>('.vistas a').forEach((a) =>
      a.classList.toggle('activo', (a.dataset.vista === 'maquina') === maquina));
  };
  document.addEventListener('astro:page-load', marcar);
</script>

<style>
  .direita { overflow: hidden; }
  .topo-dir { min-height: 0; overflow-y: auto; scrollbar-width: none; }
  .cor3 { color: var(--cor3); }

  /* Logótipo: Azeret Mono ExtraLight 36 / 1.33 / 4.32px, + "O" do Figma */
  .cabeca { display: flex; justify-content: space-between; align-items: center; margin-top: -.6875rem; }
  .logo { color: var(--cor3); text-decoration: none; font-weight: 200; font-size: 2.25rem;
    line-height: 1.33; letter-spacing: .12em; display: inline-flex; align-items: center; }
  /* "O" sorridente do Figma, por máscara, para ter a cor do logótipo */
  /* O "O" fica à mesma distância que as letras entre si: medido, o espaço
     de tinta N–N é 9,9px a 36px e N–O era 2,3px (Nuno, 22.11). */
  .logo .o { display: inline-block; margin-left: .078em; width: 1.867rem; height: 1.704rem; background: currentColor;
    -webkit-mask: url(/icones/logo-o.svg) no-repeat center / contain; mask: url(/icones/logo-o.svg) no-repeat center / contain; }

  /* Ícones: um só SVG do Figma (71×27), recortado em dois por máscara,
     para poderem mudar de cor (Color 3 = vista activa). */
  .vistas { display: flex; gap: 1.0625rem; }
  .vista { display: block; height: 1.6875rem; background: var(--texto);
    -webkit-mask: url(/icones/vistas.svg) no-repeat; mask: url(/icones/vistas.svg) no-repeat;
    -webkit-mask-size: 4.4585rem 1.6875rem; mask-size: 4.4585rem 1.6875rem; }
  .vista-humana { width: 1.856rem; -webkit-mask-position: 0 0; mask-position: 0 0; }
  .vista-maquina { width: 1.541rem; -webkit-mask-position: -2.917rem 0; mask-position: -2.917rem 0; }
  .vista.activo, .vista:hover { background: var(--cor3); }

  /* Desktop Título Bloco link: Medium Italic 28 / 1.25 / 2%, passo de 44px */
  .blocos ul { list-style: none; margin: 6.19rem 0 0; padding: 0; }
  .blocos li { font-size: 1.75rem; line-height: 2.75rem; font-style: italic; font-weight: 500;
    letter-spacing: .02em; }
  .blocos a { text-decoration: underline wavy var(--texto); text-decoration-thickness: max(1px, .04em);  /* mais fino que os 7% do Figma (Nuno, 22.11) */
    text-underline-offset: calc(.2em + .1875rem); transition: color .2s; }   /* 3px mais abaixo (22.11) */
  /* Como numa revisão de provas: o bloco por ver tem o ondulado vermelho de
     um erro por corrigir; depois de visitado fica "corrigido", em linha recta
     no tom claro (Nuno, 22.11, em experiência). */
  .blocos a:not(.visitado):not(.activo) { text-decoration-color: var(--revisao); }
  .blocos a.visitado, .blocos a.activo { text-decoration-style: solid; text-decoration-color: var(--visto); }
  .blocos a:hover { color: var(--cor3); }
  .blocos a.activo { color: var(--cor3); }

  .bio { margin-top: 2.78rem; }
  .bio p, .clientes p { margin: 0; }
  .bio p:first-child { margin-bottom: .1875rem; }
  .clientes { margin-top: 3.75rem; }

  /* Contactos, redes e CV: texto corrido em três linhas, Desktop texto
     (15 / 1.5 / 1%) na cor de contraste, 39px abaixo do filete (Figma 787:208) */
  .contactos { color: var(--cor3); }
  .contactos p { margin: 0; }
  .contactos a { text-decoration: none; }
  .contactos a:hover { text-decoration: underline; text-underline-offset: calc(.2em + .1875rem); }
  /* Figma Desktop Home (22.11): ícones à esquerda (30px, SVG do Nuno, cores
     de origem), texto alinhado à direita; as duas bases assentam juntas. */
  .pe { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
  .icones { display: flex; gap: 1.125rem; list-style: none; margin: 0; padding: 0; }
  .icones li { line-height: 0; }
  .icones img { width: 1.875rem; height: 1.875rem; display: block; }
  .icones a { transition: opacity .2s; } .icones a:hover { opacity: .7; }
  .textos { text-align: right; }

  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .direita { overflow: visible; display: block; }
    .topo-dir { overflow: visible; }
    /* Linha do logótipo a 0,556 da desktop (15px de alto, como no Figma) */
    .cabeca { margin-top: 0; }
    .logo { font-size: 1.25rem; line-height: 1; }
    .logo .o { width: 1.04rem; height: .95rem; }
    .vistas { gap: .59rem; }
    .vista { height: .9375rem; -webkit-mask-size: 2.477rem .9375rem; mask-size: 2.477rem .9375rem; }
    .vista-humana { width: 1.031rem; }
    .vista-maquina { width: .856rem; -webkit-mask-position: -1.621rem 0; mask-position: -1.621rem 0; }
    /* Mobile Título Bloco link: Bold Italic 14 / 1.25 / 1%, passo de 28px */
    .blocos ul { margin-top: 1.98rem; }
    .blocos li { font-size: .875rem; line-height: 1.75rem; font-weight: 700; letter-spacing: .01em; }
    .bio { margin-top: 1.27rem; }
    .clientes { margin-top: 2.5rem; }
    .contactos { height: auto; margin-top: 5.3rem; padding: 1.5rem 0 3rem;
      font-size: .9375rem; line-height: 1.5; letter-spacing: .01em; font-weight: 400; }
    /* email e telefone não cabem juntos a 302px: telefone na linha de baixo */
    .sep-tel { display: none; }
    .contactos .tel { display: block; }
    .pe { flex-direction: column-reverse; align-items: flex-start; gap: 1.25rem; }
    .textos { text-align: left; }
  }
</style>
