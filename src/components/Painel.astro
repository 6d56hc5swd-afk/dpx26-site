---
// Coluna direita: igual em todas as páginas e persistente na navegação
// (não se redesenha ao mudar de bloco). O activo marca-se no cliente.
// Ícones e "O" do logótipo vêm do Figma (public/icones/), sem retoques.
import { blocos, bio, clientes, contactos } from '../lib/conteudo';
---
<aside class="direita" transition:persist="painel">
  <div class="topo-dir">
    <header class="cabeca">
      <a href="/" class="logo" aria-label="DPX Studio — home"><span>DPX STUDI</span><img src="/icones/logo-o.svg" alt="" width="30" height="27" /></a>
      <nav class="vistas" aria-label="Views">
        <a href="/" class="vista vista-humana" data-vista="humana" title="Human view" aria-label="Human view"></a>
        <a href="/machine/" class="vista vista-maquina" data-vista="maquina" title="Machine view" aria-label="Machine view: content for language models and agents"></a>
      </nav>
    </header>

    <nav class="blocos" aria-label="Areas of practice">
      <ul>
        {blocos.map((b) => <li><a href={b.href} data-bloco={b.slug}>{b.especialidade}</a></li>)}
      </ul>
    </nav>

    <section class="bio texto" aria-label="About">
      <p><b class="lima">{bio.nome}</b> {bio.linha}</p>
      <p>{bio.texto}</p>
    </section>

    <section class="clientes texto" aria-label="Clients">
      <p><b class="lima">Clients</b> {clientes.map((c, i) => <>{i > 0 && <b> | </b>}<b>{c.nome}</b> {c.descricao}</>)}</p>
    </section>
  </div>

  <footer class="rodape contactos">
    <a href={`mailto:${contactos.email}`} class="email">{contactos.email}</a>
    <a href={`tel:${contactos.telefone.replace(/\s/g, '')}`} class="tel">{contactos.telefone}</a>
  </footer>
</aside>

<script>
  // Marca o bloco activo e a vista (humana/máquina) a cada mudança de página.
  const marcar = () => {
    const p = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('.blocos a').forEach((a) => {
      const on = p === a.getAttribute('href');
      a.classList.toggle('activo', on);
      if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    });
    const maquina = p.startsWith('/machine');
    document.querySelectorAll<HTMLAnchorElement>('.vistas a').forEach((a) =>
      a.classList.toggle('activo', (a.dataset.vista === 'maquina') === maquina));
  };
  document.addEventListener('astro:page-load', marcar);
</script>

<style>
  .direita { overflow: hidden; }
  .topo-dir { min-height: 0; overflow-y: auto; scrollbar-width: none; }
  .lima { color: var(--lima); }

  /* Logótipo: Azeret Mono ExtraLight 36 / 1.33 / 4.32px, + "O" do Figma */
  .cabeca { display: flex; justify-content: space-between; align-items: center; margin-top: -.6875rem; }
  .logo { color: var(--lima); text-decoration: none; font-weight: 200; font-size: 2.25rem;
    line-height: 1.33; letter-spacing: .12em; display: inline-flex; align-items: center; }
  .logo img { width: 1.867rem; height: auto; margin-left: -.25rem; }

  /* Ícones: um só SVG do Figma (71×27), recortado em dois por máscara,
     para poderem mudar de cor (lima = vista activa). */
  .vistas { display: flex; gap: 1.0625rem; }
  .vista { display: block; height: 1.6875rem; background: var(--texto);
    -webkit-mask: url(/icones/vistas.svg) no-repeat; mask: url(/icones/vistas.svg) no-repeat;
    -webkit-mask-size: 4.4585rem 1.6875rem; mask-size: 4.4585rem 1.6875rem; }
  .vista-humana { width: 1.856rem; -webkit-mask-position: 0 0; mask-position: 0 0; }
  .vista-maquina { width: 1.541rem; -webkit-mask-position: -2.917rem 0; mask-position: -2.917rem 0; }
  .vista.activo, .vista:hover { background: var(--lima); }

  /* Desktop Título Bloco link: Medium Italic 28 / 1.25 / 2%, passo de 44px */
  .blocos ul { list-style: none; margin: 6.19rem 0 0; padding: 0; }
  .blocos li { font-size: 1.75rem; line-height: 2.75rem; font-style: italic; font-weight: 500;
    letter-spacing: .02em; }
  .blocos a { text-decoration: underline wavy var(--texto); text-decoration-thickness: .07em;
    text-underline-offset: .2em; transition: color .2s; }
  .blocos a:hover { color: var(--lima); }
  .blocos a.activo { color: var(--lima); text-decoration-style: solid; }

  .bio { margin-top: 2.78rem; }
  .bio p, .clientes p { margin: 0; }
  .bio p:first-child { margin-bottom: .1875rem; }
  .clientes { margin-top: 3.75rem; }

  /* Contactos: Regular 20 / 1.25 / 2%, lima */
  .contactos { display: flex; justify-content: space-between; align-items: end; color: var(--lima);
    font-size: 1.25rem; line-height: 1.25; letter-spacing: .02em; }
  .email { text-underline-position: from-font; text-decoration-skip-ink: none; }
  .tel { text-decoration: none; position: relative; top: .3125rem; }

  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .direita { overflow: visible; display: block; }
    .topo-dir { overflow: visible; }
    /* Linha do logótipo a 0,556 da desktop (15px de alto, como no Figma) */
    .cabeca { margin-top: 0; }
    .logo { font-size: 1.25rem; line-height: 1; }
    .logo img { width: 1.04rem; }
    .vistas { gap: .59rem; }
    .vista { height: .9375rem; -webkit-mask-size: 2.477rem .9375rem; mask-size: 2.477rem .9375rem; }
    .vista-humana { width: 1.031rem; }
    .vista-maquina { width: .856rem; -webkit-mask-position: -1.621rem 0; mask-position: -1.621rem 0; }
    /* Mobile Título Bloco link: Bold Italic 14 / 1.25 / 1%, passo de 28px */
    .blocos ul { margin-top: 1.98rem; }
    .blocos li { font-size: .875rem; line-height: 1.75rem; font-weight: 700; letter-spacing: .01em; }
    .bio { margin-top: 1.27rem; }
    .clientes { margin-top: 2.5rem; }
    .contactos { height: auto; margin-top: 5.3rem; padding: 1.5rem 0 3rem; flex-direction: column;
      align-items: start; gap: 1.2rem; font-size: .9375rem; line-height: 1.5; letter-spacing: .01em; font-weight: 400; }
  }
</style>
