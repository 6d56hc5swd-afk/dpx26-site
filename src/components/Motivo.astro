---
// Motivo 3D de um bloco temático, no lugar da galeria de imagens (decisão de 22.11.2026).
// Axonometria em perspectiva, animação em loop, inclina com o cursor como a pedra da Home.
// As cenas são as mesmas das bancadas (src/lib/motivos/). A cor de contraste segue --cor3,
// que a Home sorteia ao carregar.
interface Props { numero: number }
const { numero } = Astro.props;
const DESCRICAO: Record<number, string> = {
  1: 'Line drawing of an open book, with margins, columns, baseline grid and a page turning.',
  2: 'Exploded line drawing of a design system in six layers, from grid to applications.',
  3: 'Line drawing of an exhibition plan in three rooms, with a numbered route, showcases and panels.',
  4: 'Node graph of a graphic production system, ending in stacks of printed and digital outputs.',
  5: 'Marble run as a sales funnel: from the producer’s shelf to a shipping box.',
  6: 'A maze seen from an observation tower outside it, with the path from idea to production.',
};
---
<figure class="motivo" data-motivo={numero}>
  <canvas aria-hidden="true"></canvas>
  <figcaption class="sr">{DESCRICAO[numero]}</figcaption>
</figure>

<script>
  import * as THREE from 'three';
  import { Desenho, PREDEF, deHex, enquadrar as encher } from '../lib/motivos/nucleo.js';

  const CENAS: Record<string, () => Promise<any>> = {
    1: () => import('../lib/motivos/editorial.js'),
    2: () => import('../lib/motivos/sistemas.js'),
    3: () => import('../lib/motivos/exposicoes.js'),
    4: () => import('../lib/motivos/festivais-nos.js'),
    5: () => import('../lib/motivos/ecommerce.js'),
    6: () => import('../lib/motivos/direccao.js'),
  };
  // animação de cada bloco (decisão de 22.11.2026); se a cena tiver SITE.animacao, ganha essa
  const ANIMACAO: Record<string, string> = { 1: 'folhear', 2: 'explodir', 3: 'visita', 4: 'produzir', 5: 'jogo', 6: 'percurso' };
  const INCLINA_Y = 0.2, INCLINA_X = 0.08;        // radianos, no máximo
  const BALANCO_SEG = 16, BALANCO_AMP = 0.6;      // sem cursor (toque), balança devagar
  const FONTE = 'Azeret Mono Variable';
  // reserva à volta do desenho, dentro do quadro (combinado com a sessão da maquete, 23.11.2026: 1–2rem)
  const RESERVA_REM = 1.5;

  let parar: (() => void) | null = null;

  async function iniciar() {
    const fig = document.querySelector<HTMLElement>('[data-motivo]');
    if (!fig || !CENAS[fig.dataset.motivo!]) return;
    const n = fig.dataset.motivo!;
    const cena = (await CENAS[n]()).default;
    const P = { ...cena.P, animacao: cena.SITE?.animacao ?? ANIMACAO[n], projeccao: 'perspectiva', ocultas: true };
    await document.fonts.load(`64px "${FONTE}"`).catch(() => {});

    const css = () => getComputedStyle(document.documentElement);
    const cores = () => ({ fundo: deHex(css().getPropertyValue('--fundo')), linha: deHex(css().getPropertyValue('--texto')),
      contraste: deHex(css().getPropertyValue('--cor3')) });
    const d = new Desenho(cena.ESTILOS, { estilo: cena.ESTILO ?? PREDEF.dpx, cores: cores(), fonte: FONTE });   // um bloco pode ter estilo próprio

    const canvas = fig.querySelector('canvas')!;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setClearColor(0x000000, 0);
    const scene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(30, 1, 5, 20000);
    // a vista afinada para o site (cena.SITE), ou a axonometria da bancada
    const vista = cena.SITE ?? cena.VISTAS.axonometria;
    // a cena inclina em torno do alvo da vista
    const pivo = new THREE.Group(), dentro = new THREE.Group();
    dentro.add(d.grupoE, d.grupoM); pivo.add(dentro); scene.add(pivo);
    const completo = cena.montar(P, {});              // o desenho inteiro, para medir o enquadramento

    let W = 0, H = 0;
    const enquadrar = () => {
      W = canvas.clientWidth; H = canvas.clientHeight;
      if (!W || !H) return;
      const dpr = Math.min(devicePixelRatio, 2);
      renderer.setPixelRatio(dpr); renderer.setSize(W, H, false);
      cam.aspect = W / H; cam.updateProjectionMatrix();
      // o desenho enche o quadro (Nuno, 22.11.2026): mantém o ângulo da câmara escolhida e ajusta
      // a distância e o centro a este quadro, seja desktop ou mobile; a inclinação roda em torno do novo centro
      const res = RESERVA_REM * parseFloat(getComputedStyle(document.documentElement).fontSize);
      const f = encher(completo, vista.pos, vista.alvo, cam.aspect, { margem: { x: Math.max(.5, 1 - 2 * res / W), y: Math.max(.5, 1 - 2 * res / H) }, frac: (cena.ESTILO ?? PREDEF.dpx).rotulo / 1000 });
      cam.position.set(...(f.pos as [number, number, number]));
      cam.lookAt(new THREE.Vector3(...f.alvo));
      pivo.position.set(...(f.alvo as [number, number, number]));
      dentro.position.set(-f.alvo[0], -f.alvo[1], -f.alvo[2]);
      d.acerta(W, H, dpr);
      d.escalaRotulos(cam);
      if (quieta) desenhar(0);
    };

    const quieta = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const semCursor = matchMedia('(hover: none)').matches;
    // sem movimento: a cena completa, parada (o estado final de cada animação)
    d.poe(d.grupoE, completo, cam);

    const desenhar = (t: number) => {
      if (!quieta && cena.animar) {
        const r = cena.animar(P, t) || {};
        if (r.estatico) d.poe(d.grupoE, r.estatico, cam);
        if ('movel' in r) d.poe(d.grupoM, r.movel, cam);
      }
      d.escalaRotulos(cam);
      renderer.render(scene, cam);
    };

    const ro = new ResizeObserver(enquadrar); ro.observe(canvas); enquadrar();

    // a cor de contraste é sorteada pela Home; se mudar (ou ao navegar), as linhas acompanham
    const mo = new MutationObserver(() => { d.setCores(cores()); d.poe(d.grupoE, cena.montar(P, {}), cam); });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['style'] });

    let tx = 0, ty = 0;
    const mover = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      tx = (e.clientX / innerWidth - 0.5) * 2; ty = (e.clientY / innerHeight - 0.5) * 2;
    };
    addEventListener('pointermove', mover);

    // só anima quando está à vista; o tempo da animação pára enquanto não está
    let visivel = true, tAnim = 0, antes = performance.now();
    const io = new IntersectionObserver(([e]) => { visivel = e.isIntersecting; });
    io.observe(fig);
    if (!quieta) renderer.setAnimationLoop((agora: number) => {
      const dt = Math.min(0.1, (agora - antes) / 1000); antes = agora;
      if (!visivel || !W || !H) return;
      tAnim += dt;
      // uma cena com SITE.inclina = false (a planta dos festivais) fica sempre direita: sem cursor nem balanço
      if (cena.SITE?.inclina === false) { tx = 0; ty = 0; }
      else if (semCursor) { const f = tAnim * 2 * Math.PI / BALANCO_SEG; tx = Math.sin(f) * BALANCO_AMP; ty = Math.sin(f * 2) * BALANCO_AMP * 0.4; }
      pivo.rotation.y += (tx * INCLINA_Y - pivo.rotation.y) * 0.05;
      pivo.rotation.x += (ty * INCLINA_X - pivo.rotation.x) * 0.05;
      desenhar(tAnim);
    });
    fig.classList.add('pronta');

    parar = () => {
      renderer.setAnimationLoop(null); ro.disconnect(); io.disconnect(); mo.disconnect();
      removeEventListener('pointermove', mover); d.limpa(); renderer.dispose();
    };
  }

  document.addEventListener('astro:page-load', () => { iniciar().catch(console.error); });
  document.addEventListener('astro:before-swap', () => { parar?.(); parar = null; });
</script>

<style>
  /* No lugar da galeria: a mesma largura, formato 4:5 (o dos posts). */
  .motivo { position: relative; margin: 3.94rem 0 0; padding-bottom: 3rem; }
  canvas { display: block; width: 100%; aspect-ratio: 4 / 5; opacity: 0; transition: opacity .8s; }
  .motivo.pronta canvas { opacity: 1; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .motivo { margin-top: 2.75rem; padding-bottom: 1rem; }
  }
</style>
