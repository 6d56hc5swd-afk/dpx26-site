---
// Moldura comum das páginas humanas: coluna esquerda (muda) + coluna direita
// (fixa, persiste entre páginas). Em mobile: esquerda em cima, direita a
// começar no último terço do ecrã.
import { ClientRouter } from 'astro:transitions';
import Painel from '../components/Painel.astro';
import { jsonLd } from '../lib/maquina';
import { SITE_NOME, type Bloco } from '../lib/conteudo';

interface Props { titulo: string; descricao: string; md: string; bloco?: Bloco }
const { titulo, descricao, md, bloco } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const ld = JSON.stringify(jsonLd(site, bloco));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
  <link rel="alternate" type="text/markdown" href={md} title="Markdown version for machines" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:site_name" content={SITE_NOME} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,300;0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={ld} />
  <ClientRouter fallback="swap" />
</head>
<body>
  <div class="pagina">
    <main class="esquerda" transition:animate="fade">
      <slot />
    </main>
    <div class="divisor" aria-hidden="true"></div>
    <Painel />
  </div>
</body>
</html>

<style is:global>
  :root {
    --fundo: #363530;
    --texto: #F2F1E8;
    --lima: #E5FFBE;
    --filete: #DBD9D1;
    --pedra: #6A6966;
    /* 1rem = 16px na maquete de 1728×1117; escala pela largura ou pela
       altura, a que bater primeiro, para nunca cortar. */
    font-size: min(calc(100vw / 108), calc(100svh / 69.8));
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--fundo); color: var(--texto); }
  body { font-family: 'Azeret Mono', ui-monospace, monospace; letter-spacing: .02em;
    -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  b, strong { font-weight: 700; }

  .pagina {
    height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    column-gap: 3.1rem;
    padding: 3.1rem 6.25rem;
  }
  .divisor { background: var(--filete); opacity: .8; }

  /* Esquerda e direita partilham a mesma base: filete + rodapé alinhados. */
  .esquerda, .direita { min-height: 0; display: grid; grid-template-rows: 1fr auto; }
  .rodape { border-top: 1px solid var(--filete); padding-top: 1.1rem; min-height: 6.6rem; }

  /* ── Mobile ─────────────────────────────────────────────── */
  @media (max-width: 860px) {
    :root { font-size: calc(100vw / 25.1); } /* 1rem = 16px a 402 */
    .pagina { height: auto; display: block; padding: 0 3.1rem; }
    .divisor { display: none; }
    .esquerda { height: 65svh; padding-top: 3rem; grid-template-rows: 1fr; }
    main.esquerda .rodape { display: none; }
    .direita { border-top: 1px solid var(--filete); padding-top: 1.6rem; }
  }
</style>
