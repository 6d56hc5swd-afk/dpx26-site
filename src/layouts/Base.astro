---
// Moldura comum das páginas humanas: coluna esquerda (muda) + coluna direita
// (fixa, persiste entre páginas). Em mobile: esquerda em cima, direita a
// começar no último terço do ecrã.
import { ClientRouter } from 'astro:transitions';
import Painel from '../components/Painel.astro';
import { jsonLd } from '../lib/maquina';
import { SITE_NOME, type Bloco } from '../lib/conteudo';

interface Props { titulo: string; descricao: string; md: string; bloco?: Bloco }
const { titulo, descricao, md, bloco } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const ld = JSON.stringify(jsonLd(site, bloco));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
  <link rel="alternate" type="text/markdown" href={md} title="Markdown version for machines" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:site_name" content={SITE_NOME} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:ital,wght@0,200;0,400;0,500;0,700;1,400;1,500;1,700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={ld} />
  <ClientRouter fallback="swap" />
</head>
<body>
  <div class="pagina">
    <main class="esquerda" transition:animate="fade">
      <slot />
    </main>
    <div class="divisor" aria-hidden="true"></div>
    <Painel />
  </div>
</body>
</html>

<style is:global>
  /* Medidas tiradas da maquete Figma (DPX-MIX, 712:5702 / 715:6092 / 715:6132).
     Desktop: 1rem = 16px num ecrã de 1728×1117. Mobile: 1rem = 16px a 402. */
  :root {
    --fundo: #363530;    /* Site Dark */
    --texto: #F2F1E8;    /* Site Light */
    --lima: #E5FFBE;     /* Site Color 3 */
    --filete: #F2F1E8;
    font-size: min(calc(100vw / 108), calc(100svh / 69.8));
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--fundo); color: var(--texto); }
  body { font-family: 'Azeret Mono', ui-monospace, monospace; letter-spacing: .01em;
    -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  b, strong { font-weight: 700; }

  /* Desktop texto: 15 / 1.5 / 1% */
  .texto { font-size: .9375rem; line-height: 1.5; letter-spacing: .01em; }

  .pagina {
    height: 100svh;
    display: grid;
    grid-template-columns: 1fr 2px 1fr;
    column-gap: 3.125rem;
    padding: 3.125rem 6.25rem;
  }
  .divisor { background: var(--filete); }

  /* Esquerda e direita partilham a base: filete à mesma altura (965px). */
  .esquerda, .direita { min-height: 0; display: grid; grid-template-rows: 1fr auto; }
  .rodape { border-top: 1px solid var(--filete); height: 6.375rem; }

  /* ── Mobile ─────────────────────────────────────────────── */
  @media (max-width: 860px) {
    :root { font-size: calc(100vw / 25.125); }
    body { font-weight: 200; }               /* Mobile texto: ExtraLight */
    .texto { font-size: .75rem; line-height: 1.25; }
    .pagina { height: auto; display: block; padding: 0 3.125rem; }
    .divisor { display: none; }
    .esquerda { height: 65svh; grid-template-rows: 1fr; }
    main.esquerda .rodape { display: none; }
    .direita { border-top: 2px solid var(--filete); padding-top: 1.75rem; }
  }
</style>
