---
import Base from '../layouts/Base.astro';
import Motivo from '../components/Motivo.astro';
import { blocos, projectoHtml, MARCA, type Bloco } from '../lib/conteudo';

export function getStaticPaths() {
  return blocos.map((b) => ({ params: { bloco: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Bloco };
// O motivo escolhe-se pelo bloco, não pela posição: a ordem dos blocos muda
// na Notion (22.11), mas Motivo.astro numera as cenas pela ordem antiga.
const MOTIVO: Record<string, number> = {
  'editorial-design': 1, 'information-and-brand-systems': 2, 'exhibitions-and-spaces': 3,
  'festivals-and-events': 4, 'e-commerce': 5, 'creative-direction-and-mentoring': 6,
};
---
<Base titulo={`${b.especialidade} — ${MARCA}`} descricao={`${b.titulo} ${b.descricao.replace(/\n/g, ' ')}`} md={`/${b.slug}.md`} bloco={b}>
  <article class="bloco">
    <h1 class="sr">{b.especialidade}</h1>
    <p class="intro"><b>{b.titulo.replace(/\.$/, ':')}</b> {b.descricao.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
    <Motivo numero={MOTIVO[b.slug]} />
    {b.projectos.length > 0 && <ul class="lista lista-movel texto">{b.projectos.map((p) => <li set:html={projectoHtml(p)} />)}</ul>}
  </article>
  <footer class="rodape">
    {b.projectos.length > 0 && <ul class="lista texto">{b.projectos.map((p) => <li set:html={projectoHtml(p)} />)}</ul>}
  </footer>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* Texto e imagens rolam juntos e desvanecem em cima e junto ao filete. */
  .bloco { min-height: 0; overflow-y: auto; scrollbar-width: none;
    mask-image: linear-gradient(transparent, #000 .5rem, #000 calc(100% - 2.5rem), transparent);
    -webkit-mask-image: linear-gradient(transparent, #000 .5rem, #000 calc(100% - 2.5rem), transparent); }

  /* Desktop: o motivo cabe inteiro entre a descrição e o filete (revisão do
     Nuno, 22.11). Sem scroll nem desvanecimento: a coluna é descrição + motivo,
     e o motivo ocupa a altura que sobra. O formato 4:5 do componente dava
     ~890px de alto e empurrava o desenho para baixo do filete. */
  @media (min-width: 861px) and (min-aspect-ratio: 1/1) {
    .bloco { display: flex; flex-direction: column; overflow: hidden;
      mask-image: none; -webkit-mask-image: none; }
    .bloco :global(.motivo) { flex: 1; min-height: 0; padding-bottom: 2.5rem; }
    .bloco :global(.motivo canvas) { height: 100%; aspect-ratio: auto; }
    /* Composição do Nuno (22.11): título sozinho no topo, à altura do
       logótipo; a descrição começa na linha do primeiro bloco do menu
       (linhas de base alinhadas). A caixa do título tem altura fixa para
       a descrição não saltar entre blocos. */
    .bloco .intro { font-size: 1.5rem; line-height: 1.5; max-width: 44ch; }  /* medida da composição */
    .bloco .intro b { display: block; max-width: 17ch; height: 8.84rem; }
  }

  /* Descrição em Regular; o motivo cede a altura que o texto precisar.
     Cor de contraste só no título; o texto no tom claro (Figma, 22.11) */
  .intro { margin: 0; color: var(--texto); font-size: 1.25rem; line-height: 1.5; letter-spacing: .01em; }
  .intro b { color: var(--cor3); }


  .lista { list-style: none; margin: 0; padding: 0; }
  .lista li { display: inline; }
  .lista li + li::before { content: ' · '; }   /* separadores: bullets, como na Notion */
  .lista-movel { display: none; }

  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .bloco { padding-top: 4.625rem;
      mask-image: linear-gradient(transparent 4rem, #000 4.625rem, #000 calc(100% - 2.6rem), transparent);
      -webkit-mask-image: linear-gradient(transparent 4rem, #000 4.625rem, #000 calc(100% - 2.6rem), transparent); }
    /* Mobile: Regular 14 / 1.5 / 1% */
    .intro { font-size: .875rem; font-weight: 400; }
    .lista-movel { display: block; padding: 0 0 3rem; }
    /* O desenho fica ao centro do quadro do motivo; com o 4:5 do componente
       sobrava um vazio grande por cima. Quadro mais baixo = desenho logo por
       baixo da descrição (Nuno, 22.11). */
    .bloco :global(.motivo canvas) { aspect-ratio: 5 / 4; }
  }
</style>
