---
import Frame from '../layouts/Frame.astro';
import { contactos, tagline } from '../lib/conteudo';
const ts = tagline.terminacoes;
---
<Frame titulo="DPX — Nuno Rodrigues" pagina="home">
  <div slot="z1" class="z1-home">
    <div class="pedra" title="Pedra — entra na Fase 4"></div>
  </div>
  <div slot="z2" class="z2-home">
    <address>
      <a href={`mailto:${contactos.mail}`}>{contactos.mail}</a><br />
      <a href={`tel:${contactos.telefone.replace(/\s/g, '')}`}>{contactos.telefone}</a><br />
      <a class="fora" title="Cristo-Roto — em breve" aria-disabled="true">Cristo-\-Roto</a>
    </address>
    <p class="verde tag">{tagline.formula} <span id="fim">___</span>.</p>
  </div>
</Frame>

<!-- Terminação aleatória a cada carregamento. Sem JS fica "___". -->
<script is:inline define:vars={{ ts }}>
  document.getElementById('fim').textContent = ts[Math.floor(Math.random() * ts.length)];
</script>

<style>
  .z1-home { height: 100%; display: grid; place-items: center; }
  .pedra { width: 26cqw; height: 33cqw; border-radius: 42% 46% 36% 50%;
           background: repeating-linear-gradient(92deg, rgba(242,241,232,.55) 0 2px, rgba(242,241,232,.12) 2px 5px); }
  .z2-home { height: 100%; display: flex; flex-direction: column; justify-content: space-between; }
  address { font-style: normal; }
  address a { text-decoration: none; }
  address a:hover { text-decoration: underline; }
  .fora { cursor: default; opacity: .8; }
  .tag { margin: 0; }
</style>
