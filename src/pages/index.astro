---
import Base from '../layouts/Base.astro';
import Pedra from '../components/Pedra.astro';
import { bio, hero, SITE_NOME } from '../lib/conteudo';
---
<Base titulo={`${bio.nome} — ${SITE_NOME}`} descricao={bio.texto} md="/index.md">
  <h1 class="sr">{bio.nome} — {SITE_NOME}</h1>
  <Pedra />
  <footer class="rodape legenda">
    <p class="texto"><b><i class="lima">{hero.titulo}</i></b> <span set:html={hero.legenda.replace(/<\/?b>/g, '')} /></p>
  </footer>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  /* Legenda assente no fundo, à altura do email (como no Figma) */
  .legenda { display: flex; align-items: end; }
  .legenda p { margin: 0 0 -.3rem; }
  .lima { color: var(--lima); }
</style>
