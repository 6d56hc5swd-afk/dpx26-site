---
const build = new Date().toLocaleString('pt-PT', {
  dateStyle: 'short',
  timeStyle: 'short',
  timeZone: 'Europe/Lisbon',
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>DPX26 — Fase 1</title>
		<style>
			:root { color-scheme: light dark; }
			* { box-sizing: border-box; }
			body {
				margin: 0;
				min-height: 100svh;
				display: grid;
				place-items: center;
				font: 400 16px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
				background: #0e0e0e;
				color: #e8e8e8;
			}
			main { text-align: center; padding: 2rem; }
			h1 {
				margin: 0;
				font-size: clamp(4rem, 22vw, 14rem);
				font-weight: 400;
				letter-spacing: -0.04em;
				line-height: 0.85;
			}
			p { margin: 1.5rem 0 0; font-size: 0.75rem; opacity: 0.45; }
			#vp {
				position: fixed;
				bottom: 0.75rem;
				right: 0.75rem;
				font-size: 0.7rem;
				opacity: 0.35;
				font-variant-numeric: tabular-nums;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>DPX</h1>
			<p>
				Fase 1 · circuito verificado<br />
				build {build}<br />
				sem design — o design entra na Fase 3
			</p>
		</main>
		<div id="vp"></div>
		<script is:inline>
			const vp = document.getElementById('vp');
			const paint = () => { vp.textContent = window.innerWidth + ' × ' + window.innerHeight; };
			paint();
			addEventListener('resize', paint);
		</script>
	</body>
</html>
