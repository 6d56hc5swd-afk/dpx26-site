---
import Base from '../layouts/Base.astro';
import Pedra from '../components/Pedra.astro';
import { bio, hero, MARCA } from '../lib/conteudo';
---
<Base titulo={`${MARCA} — ${bio.nome}`} descricao={bio.texto} md="/index.md">
  <h1 class="sr">{MARCA} — {bio.nome}</h1>
  <Pedra />
  <footer class="rodape legenda">
    <p class="texto"><b><i class="cor3">{hero.titulo}</i></b> <span set:html={hero.legenda.replace(/<\/?b>/g, '')} /></p>
  </footer>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  /* Legenda assente no fundo, à altura do email (como no Figma) */
  .legenda p { margin: 0; }
  .cor3 { color: var(--cor3); }
  /* Mobile: filete a 472px, legenda 13px abaixo, a 12px (Mobile texto) */
  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .legenda { padding-top: .8125rem; }
    .legenda p { margin: 0; }
  }
</style>
